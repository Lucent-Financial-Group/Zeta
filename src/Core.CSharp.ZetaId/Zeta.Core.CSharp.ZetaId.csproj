<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AssemblyName>Zeta.Core.CSharp.ZetaId</AssemblyName>
    <RootNamespace>Zeta.Core.CSharp.ZetaId</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>Zeta.Core.CSharp.ZetaId</PackageId>
    <Version>0.1.0</Version>
    <Description>Standalone C# implementation of ZetaId v1 — 128-bit canonical observation identifier (no F# dependency). Modern records + sealed DU hierarchy + UInt128.</Description>
    <Authors>Aaron Stainback (AceHack)</Authors>
    <PackageTags>zeta;zeta-id;observation;canonical-id;128-bit;firefly;agency;linq;iqbservable</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reactive" Version="6.0.1" />
    <!-- For future IObservable / IQbservable adapters in Phase 6+ -->
  </ItemGroup>

</Project>
